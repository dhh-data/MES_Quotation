# Salin menjadi .env lalu isi nilainya:   cp .env.example .env && chmod 640 .env
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# Environment variable asli di server selalu diutamakan atas isi file ini.

APP_ENV=production        # production | development
APP_DEBUG=0               # 1 hanya saat pengembangan lokal
#APP_URL=https://quotation.contoh.co.id   # kosongkan agar dideteksi otomatis

# --- Database ---
# Production menolak DB_USER=root, DB_PASS kosong, dan DB_PASS yang diawali "GANTI".
# Buat akun khusus dengan database/app_user.example.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mes_quotation
DB_USER=mes_app
DB_PASS=GANTI_DENGAN_PASSWORD_KUAT

# --- Login (semua opsional; nilai di bawah adalah bawaan) ---
AUTH_IDLE_MINUTES=30        # keluar otomatis bila tidak aktif
AUTH_ABSOLUTE_HOURS=8       # batas mutlak sejak login
AUTH_MAX_ATTEMPTS=5         # gagal berturut-turut per username+IP sebelum dikunci
AUTH_MAX_IP_ATTEMPTS=20     # gagal per IP (semua username)
AUTH_LOCKOUT_MINUTES=15     # lama jendela penguncian
AUTH_MIN_PASSWORD=10        # panjang minimal password baru
